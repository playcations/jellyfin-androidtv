<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">
    <!-- This overlay is not standalone. The real TV launcher is declared in main. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application>
        <activity android:name="org.jellyfin.androidtv.extensions.ExtensionFixtureActivity" android:exported="true" android:theme="@style/Theme.Jellyfin" />
    </application>
</manifest>
